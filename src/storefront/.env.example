# Where rrweb batches are posted. Defaults to the local file sink at /api/replay.
NEXT_PUBLIC_REPLAY_ENDPOINT=

# Elastic APM server URL for the RUM browser agent. Leave blank to disable RUM.
NEXT_PUBLIC_ELASTIC_APM_SERVER_URL=

# Server-side URL of the Eyewitness ingest service, for API call events. Blank disables.
INGEST_URL=
